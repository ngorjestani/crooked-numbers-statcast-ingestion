# Local development settings for crooked-numbers-ingest
# Copy this file to .env for local use.
# Do not commit populated secrets.

AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=crooked-numbers
AZURE_STORAGE_ACCOUNT=crookednumbers
AZURE_BLOB_CONTAINER=baseball-data

# Optional ingestion settings
STATCAST_SEASON=
STATCAST_GAME_DATE=
LOG_LEVEL=INFO
